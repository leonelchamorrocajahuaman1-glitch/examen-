# ─── Servidor ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# URL donde se abre la tienda (se usa en enlaces de correo y validación de origen)
APP_URL=http://localhost:5173

# ─── Base de datos (PostgreSQL) ──────────────────────────────
# Coincide con docker-compose.yml. Si usas un PostgreSQL instalado, cambia usuario/contraseña.
DATABASE_URL=postgresql://neon:neon_dev_password@localhost:5432/neon_liquor?schema=public

# ─── Sesiones ────────────────────────────────────────────────
SESSION_TTL_DAYS=7
# En producción con HTTPS debe ser true
COOKIE_SECURE=false
# true si el servidor está detrás de un proxy (Nginx, Hostinger, etc.)
TRUST_PROXY=false

# ─── Administrador inicial (lo crea `npm run db:seed`) ───────
ADMIN_EMAIL=admin@neonliquor.local
# Mínimo 12 caracteres. Si lo dejas vacío, el seed genera una contraseña aleatoria y la muestra en consola.
ADMIN_PASSWORD=

# ─── Pagos ───────────────────────────────────────────────────
# Modo de prueba: habilita el método "Pago de prueba" (no cobra nada). Desactívalo en producción.
PAYMENTS_TEST_MODE=true
CASH_ON_DELIVERY_ENABLED=true
# Si lo completas, se habilita "Transferencia / Yape / Plin" con verificación manual desde el panel.
# Ejemplo: BANK_TRANSFER_INFO="BCP Soles 000-0000000-0-00 · CCI 000-000-000000000000-00 · Yape 900 000 000 · Titular: Tu Empresa SAC"
BANK_TRANSFER_INFO=

# ─── Envíos (montos en céntimos) ─────────────────────────────
SHIPPING_STANDARD_CENTS=1500
SHIPPING_EXPRESS_CENTS=2990
FREE_SHIPPING_THRESHOLD_CENTS=25000

# ─── Datos de la tienda ──────────────────────────────────────
STORE_EMAIL=contacto@neonliquor.example
STORE_PHONE=+51 900 000 000
STORE_ADDRESS=Dirección de ejemplo — configúrala en server/.env
STORE_HOURS=Lun a Dom · 10:00 – 23:00

# ─── Correo (recuperación de contraseña) ─────────────────────
# Sin SMTP, en desarrollo el enlace de recuperación se muestra en la consola del servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NEON LIQUOR <no-reply@neonliquor.example>
